<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="rent_analysis_report_line_list_view" model="ir.ui.view">
        <field name="name">rent.analysis.report.line.list</field>
        <field name="model">rent.analysis.report.line</field>
        <field name="arch" type="xml">
            <tree string="Rent Analysis Report Data">
                <field name="rental_object_id"/>
                <field name="cost_center_id" type="row"/>
                <field name="contract_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="area_size"/>
                <field name="indexation_coefficient" digits="[16, 8]"/>
                <field name="rental_amount" sum="Rental"/>
                <field name="plan_rental_amount" sum="Rental Plan"/>
                <field name="rental_currency_coef" sum="Rental currency coefficient"/>
                <field name="exploitation_amount" sum="Exploitation"/>
                <field name="plan_exploitation_amount" sum="Exploitation Plan"/>
                <field name="exploitation_currency_coef" sum="Exploitation currency coefficient"/>
                <field name="marketing_amount" sum="Marketing"/>
                <field name="plan_marketing_amount" sum="Marketing Plan"/>
                <field name="marketing_currency_coef" sum="Marketing currency coefficient"/>
                <field name="rent_total" sum="Grand Total Rent"/>
                <field name="company_currency_id" optional="hidden"/>
                
                <field name="actual_rental_cost" sum="Actual Rental"/>
                <field name="actual_exploitation_cost" sum="Actual Exploitation"/>
                <field name="actual_marketing_cost" sum="Actual Marketing"/>
                <field name="actual_total_cost" sum="Actual Total"/>
                
                <field name="delta_rental" sum="Delta Rental"/>
                <field name="delta_exploitation" sum="Delta Exploitation"/>
                <field name="delta_marketing" sum="Delta Marketing"/>
                <field name="delta_total" sum="Delta Total"/>
            </tree>
        </field>
    </record>

    <record id="rent_analysis_report_line_pivot_view" model="ir.ui.view">
        <field name="name">rent.analysis.report.line.pivot</field>
        <field name="model">rent.analysis.report.line</field>
        <field name="arch" type="xml">
            <pivot string="Rent Analysis" disable_linking="true">
                <field name="rental_object_id" type="row"/>
                <field name="cost_center_id" type="row"/>              
                <field name="contract_id" type="row"/>
                <field name="date_to" type="col"/>
                <field name="rental_amount" type="measure"/>
                <field name="exploitation_amount" type="measure"/>
                <field name="marketing_amount" type="measure"/>
                <field name="rent_total" type="measure"/>

                <field name="actual_rental_cost" type="measure"/>
                <field name="actual_exploitation_cost" type="measure"/>
                <field name="actual_marketing_cost" type="measure"/>
                <field name="actual_total_cost" type="measure"/>  
                            
                <field name="delta_rental" type="measure"/>
                <field name="delta_exploitation" type="measure"/>
                <field name="delta_marketing" type="measure"/>
                <field name="delta_total" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="rent_analysis_report_line_graph_view" model="ir.ui.view">
        <field name="name">rent.analysis.report.line.graph</field>
        <field name="model">rent.analysis.report.line</field>
        <field name="arch" type="xml">
            <graph string="Rent Analysis Graph" type="bar">
                <field name="rental_object_id"/>
                <field name="date_to" interval="month"/>
                <field name="rent_total" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="rent_analysis_report_line_search_view" model="ir.ui.view">
        <field name="name">rent.analysis.report.line.search</field>
        <field name="model">rent.analysis.report.line</field>
        <field name="arch" type="xml">
            <search string="Search Rent Analysis">
                <group expand="0" string="Group By">
                    <filter name="group_by_rental_object" string="Rental Object"
                            context="{'group_by': 'rental_object_id'}"/>
                    <filter name="group_by_contract_id" string="Contract" context="{'group_by': 'contract_id'}"/>
                    <filter name="group_by_date" string="Month" context="{'group_by': 'date_to'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_rent_analysis_report_data" model="ir.actions.act_window">
        <field name="name">Rent Analysis</field>
        <field name="res_model">rent.analysis.report.line</field>
        <field name="view_mode">pivot,graph,tree</field>
        <field name="help" type="html">
            <p>
                This report allows you to analyze rental data using interactive pivot tables and graphs.
            </p>
        </field>
    </record>

</odoo>
