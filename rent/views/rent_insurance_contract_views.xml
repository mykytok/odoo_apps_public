<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_rent_insurance_contract_list" model="ir.ui.view">
        <field name="name">rent.insurance.contract.list</field>
        <field name="model">rent.insurance.contract</field>
        <field name="arch" type="xml">
            <tree default_order="start_date desc">
                <field name="rental_object_id" optional="hide"/>
                <field name="number"/>
                <field name="date"/>
                <field name="start_date"/>
                <field name="end_date"/>
            </tree>
        </field>
    </record>

    <record id="rent_insurance_contract_form" model="ir.ui.view">
        <field name="name">rent.insurance.contract.form</field>
        <field name="model">rent.insurance.contract</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="rental_object_id" required="1"/>
                        </group>
                        <group/>
                    </group>
                    <group string="Contract Details">
                        <group>
                            <field name="number"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                    </group>
                    <field name="comment" placeholder="Internal notes..."/>
                </sheet>
                <div class="oe_chatter">
                   <field name="message_follower_ids" groups="base.group_user"/>
                   <field name="message_ids" widget="mail_thread"/>
               </div>
            </form>
        </field>
    </record>

    <record id="action_rent_insurance_contract_window" model="ir.actions.act_window">
        <field name="name">Insurance Contracts</field>
        <field name="res_model">rent.insurance.contract</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="rent_menu_insurance_contract"
              action="action_rent_insurance_contract_window"
              parent="rent_menu_configuration"
              name="Insurance Contracts" sequence="210"/>

</odoo>